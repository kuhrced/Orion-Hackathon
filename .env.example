# Copy this file to .env and put your own key after the = sign.
# The .env file stays on your computer: Git ignores it. Never put a key in any other file.
GEMINI_API_KEY=
# Optional. Leave it out to use the default model, which is fast and has a generous free limit.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: the commentator's voice. Without it the browser's own voice is used.
# Get a key at https://elevenlabs.io (Developers > API keys).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: keeps what the game remembers about each player in Backboard, not only on this
# computer. Get a key at https://app.backboard.io.
BACKBOARD_API_KEY=
